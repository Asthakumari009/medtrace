# google service account credentials — never commit.
# Match by shape, not by one filename: these arrive named whatever the Cloud
# console called them, and this repo is public.
sa-vertex.json
api/sa-vertex.json
vertex.json
api/vertex.json
*service-account*.json
*-serviceaccount*.json
gcp-*.json

# vercel local project link
.vercel/

# supabase cli local state
supabase/.temp/

# Local visual QA and browser-test output
artifacts/
playwright-report/

# build logs
build-log.txt
build-release.log
.vercel
