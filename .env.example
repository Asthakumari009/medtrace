# Copy to .env and fill in from your Supabase project settings (Project Settings → API).
# Everything EXPO_PUBLIC_* is compiled into the app binary — treat it as public.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
# FastAPI extraction service. Use your computer's LAN IP when testing on a phone.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Google Sign-In web client id (Google Cloud → Credentials → OAuth 2.0 Client IDs).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

# NOTE: SUPABASE_SECRET_KEY must ONLY ever live in api/.env (server-side) or in
# Vercel's environment. Never put it here or in any EXPO_PUBLIC_* variable — it
# would ship inside the app.
