{
  "expo": {
    "name": "MedTrace",
    "slug": "vita",
    "version": "1.0.0",
    "scheme": "vita",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vita.health"
    },
    "android": {
      "package": "com.vita.health",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "default": false
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MedTrace uses the camera to photograph medical reports you choose to add. The photo is read on this device.",
          "photosPermission": "MedTrace accesses photos you select to add medical reports."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0A0B0A"
          }
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "MedTrace uses the microphone so you can ask about your records by voice."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "usesCleartextTraffic": false
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
