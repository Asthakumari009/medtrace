  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.2",
    "@vercel/config": "^0.7.1",
    "babel-preset-expo": "~57.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "python -m unittest discover -s api -p test_*.py",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "check:release": "node scripts/check-release.cjs",
    "eas-build-post-install": "node scripts/eas-post-install.cjs",
    "prebuild:android": "expo prebuild --platform android --template expo-template-bare-minimum@57.0.26",
    "dev:device": "expo start --dev-client",
    "logs:device": "adb logcat -s ReactNativeJS:V ReactNative:V",
    "perf:device": "adb shell dumpsys gfxinfo com.vita.health framestats",
    "shot:device": "adb exec-out screencap -p > artifacts/device-shot.png",
    "check:deploy": "node scripts/check-deploy.cjs"
  },
  "private": true
}
